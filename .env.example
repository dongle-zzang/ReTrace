# Private RTSP values only. Enable/configure each camera in configs/cameras.yaml.
RTSP_URL=
RTSP_URL_2=
# Optional alternative names; change rtsp_env in YAML to use these.
CCTV_1F_ELEVATOR_RTSP=
CCTV_2F_ELEVATOR_RTSP=

# Uploaded static frontend build; directory must be visible inside retrace.
FRONTEND_DIST_DIR=/workspace/ReTrace/frontend
# Internal Backend origin for same-origin /api requests on port 40225.
PREVIEW_BACKEND_URL=http://backend:8000

# Backend / PostgreSQL. Set a unique password locally; never commit it.
BACKEND_PORT=8000
# Keep loopback by default. Set an existing LAN/Tailscale interface IP locally.
BACKEND_BIND_IP=127.0.0.1
# Comma-separated exact browser origins; empty disables cross-origin API access.
# Example: http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGINS=
POSTGRES_DB=retrace
POSTGRES_USER=retrace
POSTGRES_PASSWORD=
